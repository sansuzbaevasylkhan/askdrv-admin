# AskDrv Admin — Supabase environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel, set these in:
#   Project Settings → Environment Variables
#
# Find the values in Supabase Dashboard → Project Settings → API.

# Public Supabase project URL (no trailing slash).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser; RLS enforces security).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
